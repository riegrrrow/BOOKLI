        </p>

        <div class="contact-info">
            <p><strong>Email:</strong> bookli@gmail.com</p>
            <p><strong>Телефон:</strong> +7 (495) 123‑45‑67 </p>
        </div>
    </div>
    </div>
</section>

<footer>
    © 2026 BOOKLI. Ваш книжный магазин.
</footer>

@if (!string.IsNullOrEmpty(notification))
{
    <div class="notification">@notification</div>
}

@code {
    private bool isAuthenticated = false;
    private string currentUserName = "читатель";
    private string? currentUserId;

    private HashSet<string> favoriteBookIds = new();

    private string searchText = "";
    private string selectedGenre = "Все";
    private string notification = "";

    private List<Book> books = new();

    protected override async Task OnInitializedAsync()
    {
        books = await BookService.GetBooksAsync();

        // Загружаем средние оценки читателей
        foreach (var book in books)
        {
            book.Rating = await ReviewService.GetAverageRatingAsync(book.Id);
        }

        Cart.OnChange += UpdateCatalog;

        var state = await AuthStateProvider.GetAuthenticationStateAsync();

        isAuthenticated = state.User.Identity?.IsAuthenticated ?? false;

        var user = await UserManager.GetUserAsync(state.User);

        if (user != null)
        {
            currentUserId = user.Id;
            currentUserName = user.FullName ?? user.Email ?? "читатель";

            var favorites = await FavoriteService.GetFavoritesAsync(user.Id);

            favoriteBookIds = favorites
                .Select(book => book.Id.ToString())
                .ToHashSet();
        }
    }

    private void UpdateCatalog()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Cart.OnChange -= UpdateCatalog;
    }

    private int GetBookCount(string title)
    {
        return Cart.Items
            .Where(item => item.Title == title)
            .Sum(item => item.Quantity);
    }

    private async Task ToggleFavoriteAsync(Book book)
    {
        if (string.IsNullOrEmpty(currentUserId))
        {
            notification = "Чтобы добавлять книги в избранное, войди в аккаунт.";
            return;
        }

        string bookId = book.Id.ToString();

        await FavoriteService.ToggleFavoriteAsync(
            currentUserId,
            bookId);

        if (favoriteBookIds.Contains(bookId))
        {
            favoriteBookIds.Remove(bookId);
            notification = $"Книга «{book.Title}» удалена из избранного.";
        }
        else
        {
            favoriteBookIds.Add(bookId);
            notification = $"Книга «{book.Title}» добавлена в избранное!";
        }

        await InvokeAsync(StateHasChanged);
    }

    private void AddBook(Book book)
    {
        Cart.Add(
            book.Title,
            book.Author,
            book.Price,
            book.Image
        );

        notification = $"Книга «{book.Title}» добавлена в корзину!";
    }

    private IEnumerable<Book> FilteredBooks =>
        books.Where(b =>
            (selectedGenre == "Все" ||
             string.Equals(
                 b.Genre?.Trim(),
                 selectedGenre.Trim(),
                 StringComparison.OrdinalIgnoreCase)) &&

            (string.IsNullOrWhiteSpace(searchText) ||
             (b.Title?.Contains(
                 searchText,
                 StringComparison.OrdinalIgnoreCase) ?? false) ||
             (b.Author?.Contains(
                 searchText,
                 StringComparison.OrdinalIgnoreCase) ?? false)));

    private IEnumerable<string> Genres =>
        books
            .Where(b => !string.IsNullOrWhiteSpace(b.Genre))
            .Select(b => b.Genre.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(g => g);
}
